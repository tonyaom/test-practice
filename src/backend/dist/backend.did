type _ImmutableObjectStorageRefillResult = 
 record {
   success: opt bool;
   topped_up_amount: opt nat;
 };
type _ImmutableObjectStorageRefillInformation = record {
                                                  proposed_top_up_amount:
                                                   opt nat;};
type _ImmutableObjectStorageCreateCertificateResult = 
 record {
   blob_hash: text;
   method: text;
 };
type UserSession = 
 record {
   displayName: opt text;
   role: UserRole;
   username: text;
 };
type UserRole = 
 variant {
   admin;
   user;
 };
type UserProgressInfo = 
 record {
   inProgressCount: nat;
   masteredCount: nat;
   testId: TestId;
   totalQuestions: nat;
   username: UserId;
 };
type UserId = text;
type UserDetailedProgress = 
 record {
   lifetimeTimeSpentSeconds: nat;
   tests: vec TestMasteryInfo;
   username: UserId;
 };
type UpdateTestInput = 
 record {
   description: text;
   name: text;
 };
type UpdateSectionInput = 
 record {
   description: text;
   name: text;
 };
type UpdateQuestionInput = 
 record {
   audioUrl: opt text;
   correctAnswers: vec nat;
   correctOrder: vec nat;
   correctText: text;
   explanation: opt text;
   imageBlob: opt ExternalBlob;
   options: vec text;
   questionType: QuestionType;
   sectionId: opt nat;
   "text": text;
 };
type TopTestInfo = 
 record {
   sessionCount: nat;
   testId: TestId;
   testName: text;
 };
type Timestamp = int;
type TestResult = 
 record {
   completedAt: int;
   questionResults: vec QuestionResult;
   score: nat;
   sectionResults: vec SectionResult;
   sessionId: text;
   testId: nat;
   timeSpentSeconds: nat;
   totalQuestions: nat;
   username: text;
 };
type TestProgress = 
 record {
   answers: vec AnswerSubmission;
   savedAt: int;
   selectedSectionIds: vec nat;
   sessionId: text;
   testId: nat;
   username: text;
 };
type TestMasteryInfo = 
 record {
   inProgressCount: nat;
   isTestMastered: bool;
   masteredCount: nat;
   sections: vec SectionMasteryInfo;
   testId: TestId;
   testName: text;
   timeSpentSeconds: nat;
   totalQuestions: nat;
 };
type TestId = nat;
type Test = 
 record {
   createdAt: int;
   description: text;
   id: nat;
   name: text;
   updatedAt: int;
 };
type SessionInfo = 
 record {
   completed: bool;
   sessionId: text;
   testId: nat;
 };
type SectionResult = 
 record {
   score: nat;
   sectionId: nat;
   sectionName: text;
   totalQuestions: nat;
 };
type SectionMasteryInfo = 
 record {
   isSectionMastered: bool;
   masteredCount: nat;
   sectionId: SectionId;
   sectionName: text;
   timeSpentSeconds: nat;
   totalInSection: nat;
 };
type SectionId = nat;
type Section = 
 record {
   createdAt: int;
   description: text;
   id: nat;
   name: text;
   testId: nat;
   updatedAt: int;
 };
type ReviewQuestion = 
 record {
   correctAnswer: text;
   isCorrect: bool;
   question:
    record {
      explanation: opt text;
      id: nat;
      options: vec text;
      questionType: variant {
                      dragOrder;
                      mcMulti;
                      mcSingle;
                      textInput;
                    };
      "text": text;
    };
   userAnswer: text;
 };
type ReviewData = 
 record {
   questions: vec ReviewQuestion;
   sectionScores: vec SectionResult;
   totalScore: float64;
 };
type ResetMasteryInput = 
 record {
   sectionId: opt SectionId;
   testId: TestId;
 };
type QuestionType = 
 variant {
   dragOrder;
   mcMulti;
   mcSingle;
   textInput;
 };
type QuestionResult = 
 record {
   isCorrect: bool;
   questionId: nat;
 };
type QuestionMastery = 
 record {
   correctStreak: nat;
   isMastered: bool;
   questionId: QuestionId;
   testId: TestId;
   updatedAt: Timestamp;
   userId: UserId;
 };
type QuestionId = nat;
type Question = 
 record {
   audioBlob: opt blob;
   audioDownloadStatus: opt text;
   audioUrl: opt text;
   correctAnswers: vec nat;
   correctOrder: vec nat;
   correctText: text;
   explanation: opt text;
   id: nat;
   imageBlob: opt ExternalBlob;
   options: vec text;
   orderIndex: nat;
   questionType: QuestionType;
   questionUpdatedAt: int;
   sectionId: opt nat;
   testId: nat;
   "text": text;
 };
type LoginResult = 
 variant {
   accountDeactivated;
   err: text;
   ok: UserSession;
   requiresTOTP;
 };
type ExternalBlob = blob;
type CreateTestInput = 
 record {
   description: text;
   name: text;
 };
type CreateSectionInput = 
 record {
   description: text;
   name: text;
 };
type CreateQuestionInput = 
 record {
   audioUrl: opt text;
   correctAnswers: vec nat;
   correctOrder: vec nat;
   correctText: text;
   explanation: opt text;
   imageBlob: opt ExternalBlob;
   options: vec text;
   questionType: QuestionType;
   sectionId: opt nat;
   "text": text;
 };
type AnswerSubmission = 
 record {
   orderedItems: vec nat;
   questionId: nat;
   selectedOptions: vec nat;
   textAnswer: text;
 };
type AdminUserInfo = 
 record {
   displayName: text;
   isActive: bool;
   role: variant {
           admin;
           user;
         };
   username: UserId;
 };
type AdminDashboardStats = 
 record {
   topTests: vec TopTestInfo;
   totalActiveUsers: nat;
   totalDeactivatedUsers: nat;
   totalMasteredQuestions: nat;
   totalMasteryRecords: nat;
   totalQuestions: nat;
   totalTests: nat;
   totalUsers: nat;
 };
service : {
  _immutableObjectStorageBlobsAreLive: (hashes: vec blob) -> (vec bool) query;
  _immutableObjectStorageBlobsToDelete: () -> (vec blob) query;
  _immutableObjectStorageConfirmBlobDeletion: (blobs: vec blob) -> ();
  _immutableObjectStorageCreateCertificate: (blobHash: text) ->
   (_ImmutableObjectStorageCreateCertificateResult);
  _immutableObjectStorageRefillCashier: (refillInformation:
   opt _ImmutableObjectStorageRefillInformation) ->
   (_ImmutableObjectStorageRefillResult);
  _immutableObjectStorageUpdateGatewayPrincipals: () -> ();
  addQuestion: (username: text, testId: nat, input: CreateQuestionInput) ->
   (Question);
  adminActivateUser: (callerUsername: text, username: UserId) -> (bool);
  adminDeactivateUser: (callerUsername: text, username: UserId) -> (bool);
  adminGetUserDetailedProgress: (callerUsername: text, username: UserId) ->
   (UserDetailedProgress) query;
  adminGetUserProgress: (callerUsername: text, username: UserId, testId:
   TestId) -> (opt UserProgressInfo) query;
  adminListUsers: (username: text) -> (vec AdminUserInfo) query;
  adminResetUserMastery: (callerUsername: text, username: UserId, input:
   ResetMasteryInput) -> (bool);
  createSection: (username: text, testId: nat, input: CreateSectionInput) ->
   (Section);
  createTest: (username: text, input: CreateTestInput) -> (Test);
  deleteQuestion: (username: text, questionId: nat) -> (bool);
  deleteSection: (username: text, sectionId: nat) -> (bool);
  deleteTest: (username: text, testId: nat) -> (bool);
  disable2FA: (username: text, password: text, code: text) ->
   (variant {
      err: text;
      ok;
    });
  downloadAudio: (username: text, questionId: nat, audioUrl: text) ->
   (variant {
      err: text;
      ok;
    });
  enable2FA: (username: text, code: text) -> (variant {
                                                err: text;
                                                ok;
                                              });
  getAdminDashboardStats: (callerUsername: text) ->
   (AdminDashboardStats) query;
  getAudioBlob: (questionId: nat) -> (opt blob) query;
  getMasteryForTest: (username: text, testId: TestId) ->
   (vec QuestionMastery) query;
  getQuestion: (questionId: nat) -> (opt Question) query;
  getSection: (sectionId: nat) -> (opt Section) query;
  getTest: (testId: nat) -> (opt Test) query;
  getTestProgress: (username: text, testId: nat, sessionId: text) ->
   (opt TestProgress) query;
  getTestResult: (username: text, testId: nat) -> (opt TestResult) query;
  getTestResultBySession: (username: text, testId: nat, sessionId: text) ->
   (opt TestResult) query;
  getTestReview: (username: text, testId: nat, sessionId: text) ->
   (opt ReviewData) query;
  getTwoFAStatus: (username: text) -> (bool) query;
  getUserProgress: (username: UserId) -> (UserDetailedProgress) query;
  getUserRole: (username: text) -> (opt UserRole) query;
  listActiveTestSessions: (username: text) -> (vec SessionInfo) query;
  listMyTestResults: (username: text) -> (vec TestResult) query;
  listQuestionsForTest: (testId: nat) -> (vec Question) query;
  listSectionsForTest: (testId: nat) -> (vec Section) query;
  listTests: () -> (vec Test) query;
  login: (username: text, password: text) -> (LoginResult);
  register: (username: text, password: text) -> (variant {
                                                   err: text;
                                                   ok;
                                                 });
  resetMyMastery: (username: text, input: ResetMasteryInput) -> ();
  saveTestProgress: (username: text, testId: nat, sessionId: text, answers:
   vec AnswerSubmission) -> ();
  setup2FA: (username: text) ->
   (variant {
      err: text;
      ok: record {
            text;
            text;
          };
    });
  submitTestAnswers: (username: text, testId: nat, sessionId: text,
   submissions: vec AnswerSubmission, timeSpentSeconds: nat) -> (TestResult);
  updatePassword: (username: text, currentPassword: text, newPassword:
   text) -> (variant {
               err: text;
               ok;
             });
  updateProfile: (username: text, displayName: text) ->
   (variant {
      err: text;
      ok;
    });
  updateQuestion: (username: text, questionId: nat, input:
   UpdateQuestionInput) -> (opt Question);
  updateSection: (username: text, sectionId: nat, input:
   UpdateSectionInput) -> (opt Section);
  updateTest: (username: text, testId: nat, input: UpdateTestInput) ->
   (opt Test);
  verifyTOTPLogin: (username: text, code: text) ->
   (variant {
      err: text;
      ok: UserSession;
    });
}
