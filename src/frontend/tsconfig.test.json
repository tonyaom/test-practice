{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vite/client", "node", "vitest/globals"],
    "paths": {
      "declarations/*": ["../declarations/*"],
      "@/*": ["./src/*"],
      "../../backend": ["./src/__tests__/mocks/backendStub.ts"],
      "../backend": ["./src/__tests__/mocks/backendStub.ts"],
      "../../types": ["./src/__tests__/mocks/backendStub.ts"],
      "../types": ["./src/__tests__/mocks/backendStub.ts"],
      "../../mocks/backend": ["./src/__tests__/mocks/mockBackendImpl.ts"],
      "../mocks/backend": ["./src/__tests__/mocks/mockBackendImpl.ts"],
      "../../components/QuestionForm": ["./src/__tests__/mocks/questionFormStub.ts"],
      "../components/QuestionForm": ["./src/__tests__/mocks/questionFormStub.ts"]
    }
  },
  "include": ["src/__tests__/**/*.ts", "src/__tests__/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
